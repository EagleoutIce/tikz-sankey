      \fp_compare:nNnT \l__sankey_val_fp = { 0 } { \fp_set:Nn \l__sankey_val_fp { 1 } }
      % columns: where they start, how tall their buckets are, their colors
      \int_set:Nn \l__sankey_maxcol_int { \int_max:nn { 0 } { \seq_count:N \g__sankey_bcols_seq - 1 } }
      \clist_clear:N \l__sankey_colsat_clist
