\documentclass{article}
\usepackage{tikz-sankey}
\input{regression-test}
\input{sankey-test}
\begin{document}
\START
\makeatletter
\ExplSyntaxOn
\NewExpandableDocumentCommand \SeamNow { } { \fp_to_dim:n { \__sankey_joint_seam: } }
\NewExpandableDocumentCommand \VarSeam { } { \fp_to_dim:n { \l__sankey_seam_fp } }
\NewExpandableDocumentCommand \VarTint { } { \fp_use:N \l__sankey_tint_fp }
\NewExpandableDocumentCommand \VarOpacity { } { \fp_use:N \l__sankey_opacity_fp }
\NewExpandableDocumentCommand \VarLeader { } { \fp_compare:nTF { \l__sankey_leader_fp = inf } { inf } { \fp_to_dim:n { \l__sankey_leader_fp } } }
\NewExpandableDocumentCommand \VarTdist { } { \fp_to_dim:n { \l__sankey_tdist_fp } }
\NewExpandableDocumentCommand \VarLabel { } { \tl_to_str:N \l__sankey_label_tl }
\NewExpandableDocumentCommand \VarVLabel { } { \tl_to_str:N \l__sankey_vlabel_tl }
\NewExpandableDocumentCommand \VarLayout { } { \l__sankey_layout_tl }
\NewExpandableDocumentCommand \VarFlowColor { } { \l__sankey_flowcolor_tl }
\NewExpandableDocumentCommand \VarLabelPos { } { \l__sankey_labelpos_tl }
\ExplSyntaxOff
\makeatother
% the styles below leave a mark (a macro \hit...) when the path they belong to is built
\newcommand\Hit[2]{\TestEq{#1}{\ifcsname hit#2\endcsname y\else n\fi}{y}}
\newcommand\NoHit[2]{\TestEq{#1}{\ifcsname hit#2\endcsname y\else n\fi}{n}}
% the seam, the tint and the opacity
\TestDim{default seam}{\VarSeam}{0.2pt}{0.001pt}
\TestEq{default tint}{\VarTint}{45}
\TestEq{default opacity}{\VarOpacity}{1}
\begin{tikzpicture}
\sankeySetup{seam=1pt, flow tint=30, flow opacity=.5}
\TestDim{seam}{\VarSeam}{1pt}{0.001pt}
\TestEq{tint}{\VarTint}{30}
\TestEq{opacity}{\VarOpacity}{0.5}
\end{tikzpicture}
\TestDim{seam is local}{\VarSeam}{0.2pt}{0.001pt}
% the seam under a flow into a waypoint only exists for opaque flows
\begin{tikzpicture}
\sankeySetup{seam=1pt}
\TestDim{opaque joint seam}{\SeamNow}{0.5pt}{0.001pt}
\sankeySetup{flow opacity=.5}
\TestDim{translucent joint seam}{\SeamNow}{0pt}{0.001pt}
\end{tikzpicture}
% the leader threshold: none by default, a number is a distance
\TestEq{leader none}{\VarLeader}{inf}
\begin{tikzpicture}
\sankeySetup{leader threshold=3pt}
\TestDim{leader 3pt}{\VarLeader}{3pt}{0.001pt}
\end{tikzpicture}
% every picture
\global\let\hitpic\undefined
\sankeySetup{every picture/.style={execute at begin picture={\gdef\hitpic{y}}}}
\begin{sankeypicture}[name prefix=e0-]
  \sankeyFlows{a -> b : 3}
\end{sankeypicture}
\TestEq{every picture}{\hitpic}{y}
\sankeySetup{every picture/.style={}}
% every flow, every label, every value label, every backdrop
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e1-, values, label position=after,
  every flow/.style={insert path={\pgfextra{\gdef\hitflow{y}}}},
  every label/.style={insert path={\pgfextra{\gdef\hitlabel{y}}}},
  every value label/.style={insert path={\pgfextra{\gdef\hitvlabel{y}}}},
  every backdrop/.style={insert path={\pgfextra{\gdef\hitbackdrop{y}}}},
  every inside label/.style={insert path={\pgfextra{\gdef\hitinside{y}}}}]
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\Hit{every flow}{flow}
\Hit{every label}{label}
\Hit{every value label}{vlabel}
\Hit{every backdrop}{backdrop}
\NoHit{no inside label}{inside}
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e2-, label position=inside, label backdrop=false,
  every backdrop/.style={insert path={\pgfextra{\gdef\hitbackdroptwo{y}}}},
  every inside label/.style={insert path={\pgfextra{\gdef\hitinsidetwo{y}}}}]
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\Hit{every inside label}{insidetwo}
\NoHit{backdrop off}{backdroptwo}
% every leader: only past the threshold
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e3-, label position=after, every leader/.style={insert path={\pgfextra{\gdef\hitleader{y}}}}]
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\NoHit{no leader by default}{leader}
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e4-, label position=after, leader threshold=-1pt, every leader/.style={insert path={\pgfextra{\gdef\hitleader{y}}}}]
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\Hit{leader past threshold}{leader}
% node keys: label style, value label style, text
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e5-, values, label position=after, label={\xdef\gotname{\sankeyName}}]
  \sankeyNode[text=Alpha, label style={insert path={\pgfextra{\gdef\hitnlstyle{y}}}}, value label style={insert path={\pgfextra{\gdef\hitnvstyle{y}}}}]{a}
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\TestEq{node text}{\gotname}{b}
\Hit{node label style}{nlstyle}
\Hit{node value label style}{nvstyle}
\def\gotname{}
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e6-, label position=after, label={\xdef\gotname{\gotname<\sankeyName>}}]
  \sankeyNode[text=Alpha]{a}
  \sankeyFlows{a -> b : 3}
\end{sankey}
\end{tikzpicture}
\TestEq{node text as name}{\gotname}{<Alpha><b>}
% column titles
\begin{tikzpicture}\sankeySetup{base}
\sankeySetup{column title distance=5pt}
\begin{sankey}[name prefix=e7-, column titles={T},
  every column title/.style={name=e7title, insert path={\pgfextra{\gdef\hittitle{y}}}}]
  \sankeyFlows{a -> b : 3}
\end{sankey}
\TestDim{title distance var}{\VarTdist}{5pt}{0.001pt}
\Hit{every column title}{title}
\TestHas{title node}{e7title}
\AnchorY{e7title}{base}{\ytitle}
\TestDim{title y}{\ytitle}{5pt}{0.05pt}
\end{tikzpicture}
% the legend and its swatches
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[name prefix=e8-, legend=right,
  every legend/.style={insert path={\pgfextra{\gdef\hitlegend{y}}}}, every swatch/.style={insert path={\pgfextra{\gdef\hitswatch{y}}}}]
  \sankeyGroup[label=The group]{g}
  \sankeyFlows{a -> b : 3 [group=g]}
\end{sankey}
\end{tikzpicture}
\Hit{every legend}{legend}
\Hit{every swatch}{swatch}
% routes: every bar, every route label
\begin{tikzpicture}
\sankeySetup{unit=1pt, route radius=5pt, every bar/.style={insert path={\pgfextra{\gdef\hitbar{y}}}}, every route label/.style={insert path={\pgfextra{\gdef\hitrlabel{y}}}}}
\sankeyStart[at={(0pt,0pt)}, angle=0]{r}{10}
\sankeyRoute{r}{forward=10pt}
\NoHit{no bar yet}{bar}
\sankeyRoute{r}{bar=1mm, label=R}
\end{tikzpicture}
\Hit{every bar}{bar}
\Hit{every route label}{rlabel}
% buckets: every column, column label, bucket line, bucket mark
\begin{tikzpicture}\sankeySetup{base}
\begin{sankey}[buckets, name prefix=e9-, bucket count=3, height=30pt,
  every column/.style={insert path={\pgfextra{\gdef\hitcolumn{y}}}}, every column label/.style={insert path={\pgfextra{\gdef\hitclabel{y}}}},
  every bucket line/.style={insert path={\pgfextra{\gdef\hitbline{y}}}}, every bucket mark/.style={insert path={\pgfextra{\gdef\hitbmark{y}}}}]
  \sankeyColumn[label=First]{a}
  \sankeyFlows{a@1 -> b@2 : 1}
\end{sankey}
\end{tikzpicture}
\Hit{every column}{column}
\Hit{every column label}{clabel}
\Hit{every bucket line}{bline}
\Hit{every bucket mark}{bmark}
% show values, and the presets that are made of keys
\begin{tikzpicture}
\TestEq{label default}{\VarLabel}{\detokenize{\sankeyName }}
\sankeySetup{show values}
\TestEq{show values}{\VarLabel}{\detokenize{\sankeyName \\\sankeyValue }}
\sankeySetup{show values=false}
\TestEq{show values off}{\VarLabel}{\detokenize{\sankeyName }}
\end{tikzpicture}
\begin{tikzpicture}
\sankeySetup{values}
\TestEq{values preset}{\VarVLabel}{\detokenize{\sankeyValue }}
\sankeySetup{percentages}
\TestEq{percentages preset}{\VarVLabel}{\detokenize{\sankeyShare }}
\end{tikzpicture}
\begin{tikzpicture}
\sankeySetup{mermaid}
\TestEq{mermaid layout}{\VarLayout}{justify}
\TestEq{mermaid flow color}{\VarFlowColor}{gradient}
\TestEq{mermaid label position}{\VarLabelPos}{after}
\TestEq{mermaid values}{\VarLabel}{\detokenize{\sankeyName \\\sankeyValue }}
\TestEq{mermaid tint}{\VarTint}{60}
\end{tikzpicture}
\END
\end{document}
