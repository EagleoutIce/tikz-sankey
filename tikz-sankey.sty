% TikZ helpers. They only draw: every number they get is computed by the
% layout below, and every point is a complete TikZ coordinate.
% a ribbon: #1 the command that paints it (\fill[...] or \shade[...]), #2 to #5 the
% upper edge (start, two controls, end), #6 to #9 the lower edge back to the start
\long\def\sankey@ribbon#1#2#3#4#5#6#7#8#9{%
   #1 #2 .. controls #3 and #4 .. #5 -- #6 .. controls #7 and #8 .. #9 -- cycle;
   % an outline follows the two long edges only, never the ends, where bands meet nodes or each other
   % outlines are kept and drawn once all bands are filled, so that no band covers half of
   % the outline of its neighbour
   \ifx\sankey@outline\@empty\else
      \expandafter\sankey@keepedges\expandafter{\sankey@outline}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}%
   \fi}
\long\def\sankey@keepedges#1#2#3#4#5#6#7#8#9{%
   \g@addto@macro\sankey@alledges{\sankey@edges{#1}{#2}{#3}{#4}{#5}{#6}{#7}{#8}{#9}}}
\def\sankey@alledges{}
\def\sankey@drawedges{\sankey@alledges\gdef\sankey@alledges{}}
\long\def\sankey@edges#1#2#3#4#5#6#7#8#9{%
   \draw[#1] #2 .. controls #3 and #4 .. #5;
   \draw[#1] #6 .. controls #7 and #8 .. #9;}
\def\sankey@outline{}
% a node: #1 its center, #2 and #3 its width and height, #4 the style, #5 its name
\long\def\sankey@node#1#2#3#4#5{%
   \node[shape=rectangle,inner sep=0pt,outer sep=0pt,#4,minimum width=#2,minimum height=#3,
      anchor=center,name={#5}] at #1 {};}
\long\def\sankey@leader#1#2{\draw[/sankey/every leader] #1 -- #2;}
\long\def\sankey@leaderstyled#1#2#3{\draw[#1] #2 -- #3;}
\long\def\sankey@text#1#2#3{\node[#2] at #1 {#3};}
% Labels are placed in two steps, so that they can avoid each other: the node is built
% (with its anchor at the origin) but kept in a box; once its size is known, the layout
% decides where it goes and \sankey@placelate puts it there.
\newbox\sankey@latebox
\def\sankey@savelate{%
   \global\setbox\sankey@latebox=\box\pgfpositionnodelaterbox
   \global\let\sankey@late@name\pgfpositionnodelatername
   \global\let\sankey@late@minx\pgfpositionnodelaterminx
   \global\let\sankey@late@miny\pgfpositionnodelaterminy
   \global\let\sankey@late@maxx\pgfpositionnodelatermaxx
   \global\let\sankey@late@maxy\pgfpositionnodelatermaxy}
\long\def\sankey@buildlate#1#2{%
   {\pgfpositionnodelater\sankey@savelate\node[#1] at (0pt,0pt) {#2};}%
   {\pgfpointtransformed{\pgfpointorigin}\xdef\sankey@late@ox{\the\pgf@x}\xdef\sankey@late@oy{\the\pgf@y}}}
\def\sankey@placelate#1{%
   {\setbox\pgfpositionnodelaterbox=\box\sankey@latebox
    \let\pgfpositionnodelatername\sankey@late@name
    \let\pgfpositionnodelaterminx\sankey@late@minx
    \let\pgfpositionnodelaterminy\sankey@late@miny
    \let\pgfpositionnodelatermaxx\sankey@late@maxx
    \let\pgfpositionnodelatermaxy\sankey@late@maxy
    \tikz@scan@one@point\pgfpositionnodenow#1\relax}}
% a square in the color of a legend entry
\newcommand\sankey@swatch[1]{\raisebox{\dimexpr.5ex-.8mm\relax}{\tikz\path[/sankey/every swatch,fill={#1}] (0,0) rectangle (1.6mm,1.6mm);}}
% a band of a route: a polygon (#2, a path without `-- cycle'), or a ring sector from #2
% (#3 to #5: start angle, delta angle and radius) back along #6 (#7 to #9)
\long\def\sankey@poly#1#2{\fill[#1] #2 -- cycle;}
\long\def\sankey@path#1#2{\path[#1] #2 -- cycle;}
\long\def\sankey@arcband#1#2#3#4#5#6#7#8#9{%
   \fill[#1] #2 arc[start angle=#3,delta angle=#4,radius=#5] -- #6 arc[start angle=#7,delta angle=#8,radius=#9] -- cycle;}
% the canvas position of a TikZ coordinate, into \sankey@px and \sankey@py
\def\sankey@getpoint#1{\tikz@scan@one@point\sankey@gotpoint#1\relax}
\def\sankey@gotpoint#1{\pgf@process{#1}\xdef\sankey@px{\the\pgf@x}\xdef\sankey@py{\the\pgf@y}}

\ExplSyntaxOn

% Messages
\msg_new:nnn { tikz-sankey } { outside }
   { \token_to_str:N #1 ~ can ~ only ~ be ~ used ~ inside ~ a ~ sankey ~ environment. }
\msg_new:nnn { tikz-sankey } { narrow }
   { The ~ labels ~ need ~ #1 ~ more ~ than ~ the ~ width ~ of ~ the ~ diagram. }
\msg_new:nnn { tikz-sankey } { nested } { sankey ~ environments ~ cannot ~ be ~ nested. }
\msg_new:nnn { tikz-sankey } { unknown-node }
   { The ~ flow ~ `#1' ~ -> ~ `#2' ~ names ~ the ~ undeclared ~ node ~ `#3'. ~ Declare ~ it ~ with ~
     \token_to_str:N \sankeyNode \ or ~ set ~ `auto ~ nodes'. ~ The ~ flow ~ is ~ dropped. }
\msg_new:nnn { tikz-sankey } { negative }
   { The ~ flow ~ `#1' ~ -> ~ `#2' ~ has ~ the ~ negative ~ value ~ #3. ~ It ~ is ~ dropped. }
\msg_new:nnn { tikz-sankey } { backwards }
   { The ~ flow ~ `#1' ~ -> ~ `#2' ~ runs ~ from ~ column ~ #3 ~ to ~ column ~ #4, ~ but ~ flows ~ must ~
     run ~ to ~ a ~ later ~ column. ~ The ~ flow ~ is ~ dropped. }
\msg_new:nnn { tikz-sankey } { cycle }
   { Dropped ~ to ~ break ~ a ~ cycle: ~ #1. ~ Give ~ the ~ nodes ~ columns ~ to ~ keep ~ these ~ flows. }
\msg_new:nnn { tikz-sankey } { empty } { The ~ diagram ~ has ~ no ~ node ~ with ~ a ~ positive ~ value. ~ Nothing ~ is ~ drawn. }
\msg_new:nnn { tikz-sankey } { too-small }
   { The ~ height ~ (#1) ~ leaves ~ no ~ room ~ for ~ the ~ nodes ~ after ~ the ~ gaps. ~ Increase ~ `height' ~ or ~ set ~ `unit'. }
\msg_new:nnn { tikz-sankey } { value-too-small }
   { Node ~ `#1' ~ has ~ the ~ value ~ #2, ~ but ~ its ~ flows ~ carry ~ #3. ~ It ~ grows ~ to ~ #3. }
\msg_new:nnn { tikz-sankey } { choice } { The ~ key ~ `#1' ~ does ~ not ~ accept ~ `#2' ~ (choose ~ one ~ of ~ #3). }
\msg_new:nnn { tikz-sankey } { bad-flow }
   { Cannot ~ read ~ `#1' ~ as ~ a ~ flow; ~ write ~ `from ~ -> ~ to ~ : ~ value' ~ (more ~ nodes ~ chain ~ with ~ `->'). }
\msg_new:nnn { tikz-sankey } { unknown-info }
   { \token_to_str:N \sankeyNodeInfo \ knows ~ no ~ `#1' ~ (see ~ the ~ manual ~ for ~ the ~ keys ~ it ~ knows). }

