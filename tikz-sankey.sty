         {
            \__sankey_set:nne { v } {##1} { \fp_eval:n { max ( \__sankey_get:nn { in } {##1} , \__sankey_get:nn { out } {##1} ) } }
            \fp_set:Nn \l__sankey_val_fp { max ( \l__sankey_val_fp , \__sankey_get:nn { v } {##1} ) }
         }
