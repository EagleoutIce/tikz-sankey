% Each value is a control sequence of its own (a hash lookup, where a property list would be
% searched); the number of the diagram is part of its name, so a new diagram starts empty.
\int_new:N \g__sankey_id_int
\cs_new:Npn \__sankey_get:nn #1#2 { \cs:w g__sankey_ \int_use:N \g__sankey_id_int _#1_ #2 \cs_end: }
\cs_generate_variant:Nn \__sankey_get:nn { ne , nV }
\cs_new_protected:Npn \__sankey_set:nnn #1#2#3
   { \cs_gset_nopar:cpe { g__sankey_ \int_use:N \g__sankey_id_int _#1_ #2 } { \exp_not:n { \exp_not:n {#3} } } }
\cs_generate_variant:Nn \__sankey_set:nnn { nne , nnV , nVn , nVe , nee , nen , nVV }
\prg_new_conditional:Npnn \__sankey_has:nn #1#2 { p , T , F , TF }
   { \cs_if_exist:cTF { g__sankey_ \int_use:N \g__sankey_id_int _#1_ #2 } { \prg_return_true: } { \prg_return_false: } }
\prg_generate_conditional_variant:Nnn \__sankey_has:nn { nV , ne } { p , T , F , TF }
% an attribute of a node, or #3 if it has none
\cs_new:Npn \__sankey_get_or:nnn #1#2#3 { \__sankey_has:nnTF {#1} {#2} { \__sankey_get:nn {#1} {#2} } {#3} }
\cs_generate_variant:Nn \__sankey_get_or:nnn { nen , nVV , nVn }

