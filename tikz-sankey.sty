               { \__sankey_has:neTF { fgroup } {##1} { \__sankey_get:ne { gidx } { \__sankey_get:nn { fgroup } {##1} } } { 0 } }
            \str_if_eq:eeT { \__sankey_get:nV { bcol } \l__sankey_a_tl } { \__sankey_get:nV { bcol } \l__sankey_b_tl }
               { \__sankey_set:nnn { floop } {##1} { 1 } }
            \__sankey_has:nnF { floop } {##1}
               {
                  \__sankey_set:nVn { nlout } \l__sankey_a_tl { 1 }
                  \__sankey_set:nVn { nlin } \l__sankey_b_tl { 1 }
               }
            \fp_compare:nNnT { \__sankey_get:nn { fval } {##1} } > { 0 }
